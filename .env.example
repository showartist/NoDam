# ── 필수 ────────────────────────────────────────────────────────────────
# OpenRouter 하나로 STT(Grok)와 동상이몽 분석(LLM)을 모두 호출한다.
# 없으면 앱은 뜨지만 전사·분석이 NOT_CONFIGURED 오류를 낸다. (가짜 성공을 만들지 않는다)
# 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── 선택 ────────────────────────────────────────────────────────────────
# 모델 교체용. 비우면 아래 기본값을 쓴다.
# OPENROUTER_STT_MODEL=x-ai/grok-stt-1.0
# OPENROUTER_ANALYSIS_MODEL=anthropic/claude-sonnet-5

# 같은 화자 안에서 발언을 나누는 침묵 기준(ms). 기본 400.
# 화자가 바뀌면 이 값과 무관하게 항상 나뉜다.
# STT_UTTERANCE_GAP_MS=400

# 로컬 SQLite 파일 경로. 기본 .data/scenesync.db
# SCENENOTE_DB=

# Neon PostgreSQL. 작품 바이블(project-visual)과 Shot Recipe API 에만 쓴다.
# 없으면 그 화면들이 "영속 DB 연결이 필요합니다" 오류를 표시한다 (정상 동작).
# 5단계 데모와 동상이몽 파이프라인은 이것 없이 돌아간다.
# DATABASE_URL=

# ── 해석 차이 탐지 v2 · 음성 사이드카 · 회의 중 화면 (선택) ────────────────
# 전체 목록과 기본값은 docs/V2_PIPELINE_GUIDE.md 8절.
# SCENENOTE_ANALYSIS_MODEL=anthropic/claude-sonnet-5
# SCENENOTE_JUDGE_MODEL=anthropic/claude-haiku-4.5
# SCENENOTE_WINDOW_MODEL=anthropic/claude-haiku-4.5
# SCENENOTE_IMAGE_MODEL=google/gemini-3.1-flash-image

# 음성 사이드카(sidecar/, 로컬 파이썬). 꺼져 있으면 Grok 화자를 그대로 쓴다.
# SIDECAR_PORT=8790

# 있으면 긴 회의를 xAI STT 로 파일 하나에 보낸다(미검증).
# XAI_API_KEY=
